# giflib has a Makefile upstream. Prefer a system development package on
# Linux, then build just the unmodified decoder sources as a fallback.
set(liltview_gif_system_library "")
set(liltview_gif_system_include "")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    foreach(candidate /usr/include/gif_lib.h /usr/local/include/gif_lib.h /usr/lib64/include/gif_lib.h)
        if(EXISTS "${candidate}")
            get_filename_component(liltview_gif_system_include "${candidate}" DIRECTORY)
            break()
        endif()
    endforeach()
    foreach(candidate /usr/lib/libgif.so /usr/lib/libgif.a /usr/lib64/libgif.so /usr/lib64/libgif.a
                    /usr/local/lib/libgif.so /usr/local/lib/libgif.a)
        if(EXISTS "${candidate}")
            set(liltview_gif_system_library "${candidate}")
            break()
        endif()
    endforeach()
endif()
if(liltview_gif_system_library AND liltview_gif_system_include)
    add_library(liltview_gif INTERFACE)
    target_include_directories(liltview_gif SYSTEM INTERFACE "${liltview_gif_system_include}")
    target_link_libraries(liltview_gif INTERFACE "${liltview_gif_system_library}")
    if(LILTVIEW_BUILD_UNIT_TESTS)
        add_library(liltview_gif_encoder INTERFACE)
        target_link_libraries(liltview_gif_encoder INTERFACE liltview_gif)
    endif()
    liltview_dependency_status("giflib" "system" "${liltview_gif_system_library}")
else()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        liltview_dependency_source_or_fetch(giflib gif_lib.h gif_source)
    else()
        liltview_dependency_source(giflib gif_lib.h gif_source)
    endif()
    add_library(liltview_gif STATIC
        "${gif_source}/dgif_lib.c" "${gif_source}/gifalloc.c"
        "${gif_source}/gif_err.c" "${gif_source}/openbsd-reallocarray.c")
    target_include_directories(liltview_gif SYSTEM PUBLIC "${gif_source}")
    set_target_properties(liltview_gif PROPERTIES C_STANDARD 99)
    if(LILTVIEW_BUILD_UNIT_TESTS)
        add_library(liltview_gif_encoder STATIC "${gif_source}/egif_lib.c" "${gif_source}/gif_hash.c")
        target_link_libraries(liltview_gif_encoder PUBLIC liltview_gif)
    endif()
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        liltview_dependency_status("giflib" "fetched" "liltview_gif")
