pkgname=liltview
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='A lightweight image viewer with a C23 core and ImGui interface'
arch=('x86_64')
url='https://github.com/hui-livio/LiltView'
license=('Apache-2.0' 'MIT' 'Zlib' 'Libpng-2.0' 'BSD-3-Clause' 'IJG'
         'BSL-1.0' 'FTL' 'libtiff' 'LicenseRef-HarmonyOS-Sans')
depends=(
  'glibc' 'gcc-libs' 'fontconfig' 'glib2' 'libglvnd' 'wayland' 'libxkbcommon'
  'libx11' 'libxcursor' 'libxext' 'libxfixes' 'libxi' 'libxrandr' 'libxss' 'libxtst'
  'libdecor' 'dbus' 'desktop-file-utils' 'hicolor-icon-theme'
)
makedepends=('cmake>=3.30' 'ninja' 'pkgconf' 'gcc>=15' 'nasm')
optdepends=('opengl-driver: OpenGL implementation for your graphics hardware')
options=('!debug')
source=("liltview-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
  # Keep __FILE__ diagnostics useful without embedding the builder's local path.
  export CFLAGS="${CFLAGS} -ffile-prefix-map=\"${srcdir}\"=."
  export CXXFLAGS="${CXXFLAGS} -ffile-prefix-map=\"${srcdir}\"=."
  cmake -S "${srcdir}/liltview-${pkgver}" -B "${srcdir}/build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_C_FLAGS_RELEASE=-DNDEBUG \
    -DCMAKE_CXX_FLAGS_RELEASE=-DNDEBUG \
    -DLILTVIEW_CXX_STANDARD=23 \
    -DLILTVIEW_BUILD_APP_COMPONENTS=ON \
    -DLILTVIEW_ENABLE_GLOBAL_MENU=ON \
    -DLILTVIEW_BUILD_UNIT_TESTS=OFF \
    -DBUILD_TESTING=OFF \
    -DSDL_X11=ON -DSDL_WAYLAND=ON -DSDL_KMSDRM=OFF -DSDL_LIBUDEV=OFF -DSDL_IBUS=OFF
  cmake --build "${srcdir}/build"
}

check() {
  "${srcdir}/build/app/liltview" --version
  desktop-file-validate "${srcdir}/liltview-${pkgver}/packaging/linux/io.github.hui_livio.LiltView.desktop"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "${srcdir}/build"
  # Arch license directories follow the lowercase package name.
  mv "${pkgdir}/usr/share/licenses/LiltView" "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 "${srcdir}/liltview-${pkgver}/assets/fonts/LICENSE.HarmonyOS-Sans.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/HarmonyOS-Sans/LICENSE.txt"
}
